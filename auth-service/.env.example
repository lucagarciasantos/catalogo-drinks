# Porta HTTP do auth-service
AUTH_PORT=3001

# Segredo do JWT. DEVE ser identico no resource-service para validacao local.
# Em producao, use um valor longo e aleatorio (e nunca commite o .env real).
JWT_SECRET=troque-este-segredo-compartilhado
JWT_EXPIRES_IN=1h

# Arquivo SQLite proprio deste servico (NAO compartilhar com outros servicos)
DB_FILE=auth.sqlite

# Redis (usado para espelhar tokens revogados no logout)
REDIS_URL=redis://localhost:6379

# Rate limiting do login
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10

# Nome usado nos logs
SERVICE_NAME=auth-service
