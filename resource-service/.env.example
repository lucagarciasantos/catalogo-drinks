# Porta HTTP do resource-service
RESOURCE_PORT=3002

# Segredo do JWT. DEVE ser identico ao do auth-service (validacao local do token).
JWT_SECRET=troque-este-segredo-compartilhado

# Arquivo SQLite proprio deste servico (NAO compartilhar com outros servicos)
DB_FILE=resource.sqlite

# Redis (publicacao de eventos e checagem de tokens revogados)
REDIS_URL=redis://localhost:6379

# TTL do cache em memoria das buscas (ms)
CACHE_TTL_MS=30000

# Nome usado nos logs
SERVICE_NAME=resource-service
